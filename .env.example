# --- LLM provider ---
# "gemini" or "openrouter" (explicit opt-in only;
# there is no automatic fallback between the two).

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=........
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- RAG / vector store 
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.25
