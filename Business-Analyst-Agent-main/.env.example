# --- LLM provider ---
# "openrouter" 
LLM_PROVIDER=openrouter

GEMINI_API_KEY=......
GEMINI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=.....
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- RAG / vector store 
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.25


# --- Web backend: persistence, accounts, uploads ----------------------------
# sqlite (default): conversations and session history survive a restart.
# memory: everything is lost when the server stops.
SESSION_PERSISTENCE=sqlite
# Where the backend keeps its SQLite files (created automatically)
DATA_DIR=C:\Users\Hp\OneDrive\Desktop\BA\BusinessAnalyst-Agent\BusinessAnalyst-Agent-main\data

# Usernames reserved for administrators (comma-separated). They can NOT be
# self-registered; create them with:  python3 scripts/create_user.py --admin <name>
ADMIN_USERNAMES=shayan_admin

# true = anyone can create a normal account from the sign-in page
ALLOW_REGISTRATION=true
# How long a login stays valid
AUTH_TOKEN_TTL_HOURS=12
# Maximum size of a knowledge-base upload (bytes). 5242880 = 5 MB
MAX_UPLOAD_BYTES=5242880
